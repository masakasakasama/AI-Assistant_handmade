OPENAI_API_KEY=
PORT=8787
ROUTER_MODEL=gpt-6-luna
REASONING_MODEL=gpt-6.1-sol
REASONING_EFFORT=high

JEV_OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
JEV_ENDPOINT=https://openrouter.ai/api/alpha/decisions

# HTTP API default; clients may choose quick/balanced/deep.
ANSWER_MODE=balanced

# Owner-entered client access token, separate from provider keys. Required for POST APIs.
AI_BACKEND_TOKEN=

# Shared request limits: free Neon database (initialize sql/request-limits.sql),
# or provide AI_LIMIT_REDIS_URL and AI_LIMIT_REDIS_TOKEN for Redis instead.
AI_LIMIT_DATABASE_URL=
AI_DAILY_REQUEST_LIMIT=500
AI_RATE_REQUEST_LIMIT=20
